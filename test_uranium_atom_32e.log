# ==============================================================================
# ANGULAR MOMENTUM OPERATOR L^2 & SPECTROSCOPY TOOLKIT
# ==============================================================================
def get_orbital_angular_momentum(mol, mo_cas):
    mol.set_common_origin([0.0, 0.0, 0.0])
    irxp = mol.intor('int1e_cg_irxp')
    L_ao = -1j * irxp
    return np.einsum('pi, xpq, qj -> xij', mo_cas.conj(), L_ao, mo_cas)


def calc_L_square_from_rdm(L_cas, casdm1, casdm2):
    L2_total = 0.0
    for k in range(3):
        Lk = L_cas[k]
        Lk2 = Lk @ Lk
        term1 = np.einsum('ps, ps ->', Lk2, casdm1)
        term2 = np.einsum('pq, rs, pqrs ->', Lk, Lk, casdm2)
        L2_total += (term1 + term2).real

    L_eff = (-1.0 + np.sqrt(1.0 + 4.0 * max(0.0, L2_total))) / 2.0
    return L2_total, L_eff


def format_term_symbol(mult, l_eff):
    l_idx = int(round(l_eff))
    char = TERM_LETTERS[l_idx] if 0 <= l_idx < len(TERM_LETTERS) else f"L={l_idx}"
    mult_int = int(round(mult))
    return f"^{mult_int}{char}"


# ==============================================================================
# BOOKKEEPING & POPULATION ANALYSIS
# ==============================================================================
class CycleCounter:
    KEYS_E = ('e_tot', 'etot')
    KEYS_G = ('norm_g', 'norm_gorb', 'grad_norm', 'gnorm')

    def __init__(self):
        self.n = 0
        self.e_last = None
        self.e_prev = None
        self.g_last = None
        self.macros = set()

    def __call__(self, envs):
        self.n += 1
        im = envs.get('imacro')
        if im is not None:
            self.macros.add(int(im))
        e = next((envs[k] for k in self.KEYS_E if k in envs), None)
        if e is not None:
            self.e_prev, self.e_last = self.e_last, float(e)
        g = next((envs[k] for k in self.KEYS_G if k in envs), None)
        if g is not None:
            self.g_last = float(g)

    @property
    def prec(self):
        parts = []
        if None not in (self.e_last, self.e_prev):
            parts.append(f'dE {abs(self.e_last - self.e_prev):.1e}')
        if self.g_last is not None:
            parts.append(f'g {self.g_last:.1e}')
        return ', '.join(parts) if parts else '—'

    def summary(self):
        if self.macros:
            return f'{len(self.macros)} macro'
        return f'{self.n} cyc' if self.n else None


def _counted_kernel(mf, dm0=None):
    cc = CycleCounter()
    mf.callback = cc
    t0 = time.perf_counter()
    mf.kernel(dm0)
    return cc, time.perf_counter() - t0


def _stage(label, cc):
    s = cc.summary()
    return f'{label} {s}' if s else label


def ao_l_list(mol):
    out = []
    for b in range(mol.nbas):
        l = mol.bas_angular(b)
        out += [l] * (2 * l + 1) * mol.bas_nctr(b)
    return np.array(out)


def l_weights(ctx, mo):
    if mo is None:
        raise RuntimeError('mo_coeff is None — SCF did not run!')
    mo = np.asarray(mo, dtype=float)
    s2, U = np.linalg.eigh(ctx.S)
    Co = (U * np.sqrt(s2)) @ U.T @ mo
    W = np.stack([(Co[ctx.l_ao == l]**2).sum(0) for l in range(int(ctx.l_ao.max()) + 1)])
    return W


def valence_config(ctx, occ, mo, etol=CFG_PRINT_TOL):
    occ, mo = np.asarray(occ, dtype=float), np.asarray(mo, dtype=float)
    if occ.ndim == 2:
        nel = sum(o @ l_weights(ctx, c).T for o, c in zip(occ, mo))
    else:
        nel = occ @ l_weights(ctx, mo).T
    tags = 'spdfgh'
    raw = {tags[l]: round(float(n), 2) for l, n in enumerate(nel) if n > etol}
    val = {tags[l]: round(float(n - CORE_MAP.get(l, 0)), 2)
           for l, n in enumerate(nel) if n - CORE_MAP.get(l, 0) > etol}
    print('  per-l raw:', raw, '\n  valence  :', val)
    return val


def fmt_cfg(cfg):
    return ' '.join(f'{l}^{n:.2f}' for l, n in cfg.items()) if cfg else '(none)'


def config_matches(cfg):
    if not cfg:
        return False
    return all(l in cfg and abs(cfg[l] - n) <= CFG_TOL for l, n in TARGET_CFG.items())


def slug(name):
    s = (name.lower().replace('<', '_').replace('-', '_')
         .replace('*', '').replace(' ', '_'))
    while '__' in s:
        s = s.replace('__', '_')
    return s


def large_ci_cut(ci, ncas, nelecas, cut=CSF_CUTOFF):
    params = inspect.signature(fci.addons.large_ci).parameters
    for kw in ('tol', 'lim', 'cutoff'):
        if kw in params:
            return fci.addons.large_ci(ci, ncas, nelecas, **{kw: cut})
    return fci.addons.large_ci(ci, ncas, nelecas, cut)


# ==============================================================================
# SCF ENGINE & CHECKPOINTING
# ==============================================================================
def make_scf(ctx, kind, xc=None):
    mf = {'ROHF': ctx.mol.ROHF, 'UHF': ctx.mol.UHF, 'UKS': ctx.mol.UKS}[kind]()
    if xc:
        mf.xc = xc
    mf.verbose = SCF_VERBOSE
    return mf


def seed_from_chk(mf, tag):
    path = f'{tag}.chk'
    if not (WARM and os.path.exists(path)):
        return False, None
    try:
        mol_chk, rec = scf.chkfile.load_scf(path)
        if mol_chk.nao_nr() != mf.mol.nao_nr() or mol_chk.nelectron != mf.mol.nelectron:
            print(f'  [{tag}] chk belongs to different system -> cold start')
            return False, None
        mf.mo_coeff, mf.mo_occ = rec['mo_coeff'], rec['mo_occ']
        if rec.get('mo_energy') is not None:
            mf.mo_energy = rec['mo_energy']
        print(f'  [{tag}] warm seed (E_prev={rec["e_tot"]:.8f})')
        return True, rec.get('e_tot')
    except Exception as ex:
        print(f'  [{tag}] chk seed failed ({ex}) -> cold start')
        return False, None


def run_scf(ctx, name, kind, strategy=('DIIS', 'SOSCF'), xc=None, dm0=None):
    tag = slug(name)
    mf = make_scf(ctx, kind, xc)

    if any(st in ('SMEAR', 'SMEARFS', 'CLEAN') for st in strategy):
        seeded, e_prev = False, None
    else:
        seeded, e_prev = seed_from_chk(mf, tag)

    if seeded:
        dm0 = mf.make_rdm1(mf.mo_coeff, mf.mo_occ)
        notes = ['warm verify']
    else:
        notes = []

    mf.chkfile, mf.conv_tol = f'{tag}.chk', CONV_TOL
    stages, wall, cc_last = [], 0.0, None

    for st in strategy:
        if st == 'DIIS':
            mf.diis_start_cycle = DIIS_START
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('DIIS', cc))
        elif st == 'SOSCF':
            mf = mf.newton()
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_SOSCF
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SOSCF', cc))
        elif st == 'SMEAR':
            mf = _smear_fn(mf, sigma=SMEAR_SIGMA)
            if dm0 is not None and np.ndim(dm0) == 3 and not mf.istype('UHF'):
                dm0 = np.dot(mf.mo_coeff * mf.mo_occ, mf.mo_coeff.T)
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SMEAR', cc))
            notes.append(f'gaussian smear sigma={SMEAR_SIGMA}')
        elif st == 'SMEARFS':
            mf = _smear_fn(mf, sigma=SMEAR_SIGMA, fix_spin=True)
            mf.max_cycle = MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SMEARFS', cc))
            notes.append(f'gaussian smear sigma={SMEAR_SIGMA}, fix_spin')
        elif st == 'CLEAN':
            dm = mf.make_rdm1()
            mf = make_scf(ctx, kind, xc)
            mf.chkfile, mf.conv_tol = f'{tag}.chk', CONV_TOL
            mf.max_cycle = MAX_DIIS
            cc, t = _counted_kernel(mf, dm)
            stages.append(_stage('CLEAN', cc))
            notes.append('integer restart from smeared dm')

        wall += t
        cc_last = cc
        if mf.converged:
            break

    if seeded and e_prev is not None and mf.converged:
        d = abs(mf.e_tot - e_prev)
        notes.append(f'stationary: dE_vs_chk {d:.1e}')

    mf._meta = dict(cycles=' + '.join(stages), t=wall, prec=cc_last.prec if cc_last else '—')
    return mf, '; '.join(notes) or '->'.join(strategy)


# ==============================================================================
# PIPELINE SETUP & REGISTRATION
# ==============================================================================
def build_system():
    mol = libgrpp4pyscf.GRPPMole()
    mol.build(atom=ATOM, basis=BASIS, ecp=ECP, spin=SPIN, charge=CHARGE,
              unit=UNIT, verbose=VERBOSE)
    libgrpp4pyscf.compare_integrals_with_pyscf(mol, verbose=True, gradients=False)
    l_ao = ao_l_list(mol)
    assert not mol.cart and (l_ao == 3).sum() >= 7, 'need spherical f functions'
    return SimpleNamespace(
        mol=mol, S=mol.intor('int1e_ovlp'), l_ao=l_ao,
        na=(mol.nelectron + SPIN)//2, nb=(mol.nelectron - SPIN)//2,
        rows=[], mf_ref=None, mc=None, noon=None, natorb=None)


def add_row(ctx, name, mf, note, s2=None, l2=np.nan, cfg=None):
    conv = bool(getattr(mf, 'converged', False))
    if conv and s2 is None:
        try:
            s2 = mf.spin_square()[0]
        except Exception:
            s2 = np.nan
    if conv and cfg is None:
        cfg = valence_config(ctx, mf.mo_occ, mf.mo_coeff)

    occ = np.asarray(mf.mo_occ, dtype=float)
    if occ.ndim == 2:
        szv = float(occ[0].sum() - occ[1].sum()) / 2
    elif hasattr(mf, 'ncas'):
        szv = (ctx.na - ctx.nb) / 2
    elif hasattr(mf, 'istype') and mf.istype('ROHF'):
        szv = (ctx.na - ctx.nb) / 2
    else:
        szv = None

    meta = getattr(mf, '_meta', {})
    ctx.rows.append(dict(name=name, mf=mf, conv=conv, E=mf.e_tot, S2=s2, L2=l2,
                         Sz=szv, cfg=cfg, note=note,
                         cycles=meta.get('cycles', '—'),
                         t=meta.get('t', 0.0), prec=meta.get('prec', '—')))


# ==============================================================================
# STAGE 1: SINGLE REFERENCE BENCHMARKS
# ==============================================================================
STAGE1_SPEC = [
    ('ROHF',           'ROHF', ('DIIS', 'SOSCF')),
    ('ROHF-smear*',    'ROHF', ('SMEAR', 'CLEAN')),
    ('UHF',            'UHF',  ('DIIS', 'SOSCF')),
    ('UHF-smear*',     'UHF',  ('SMEAR', 'CLEAN')),
    ('UKS-PBE',        'UKS',  ('DIIS', 'SOSCF')),
    ('UKS-PBE-smear*', 'UKS',  ('SMEAR', 'CLEAN')),
    ('UKS-PBE-smear-fs*', 'UKS', ('SMEARFS', 'CLEAN')),
]

def stage1_scf(ctx):
    for name, kind, strategy in STAGE1_SPEC:
        mf, note = run_scf(ctx, name, kind, strategy, xc=XC if kind == 'UKS' else None)
        add_row(ctx, name, mf, note)


# ==============================================================================
# STAGE 2: MULTICONFIGURATION & SPECTROSCOPY
# ==============================================================================
def pick_cas(ctx, mf):
    """
    Selects the complete, rotationally invariant atomic valence active space:
      1 x 7s  (l=0)
      5 x 6d  (l=2)
      7 x 5f  (l=3)
    Total = 13 orbitals. This full SO(3) multiplet ensures L^2 is closed and exact.
    """
    e = mf.mo_energy
    occ = mf.mo_occ
    W = l_weights(ctx, mf.mo_coeff)

    # 1. 5 valence occupied orbitals from top of occupied spectrum (7s, 6d, 3x 5f)
    occ_idx = sorted((i for i in range(ctx.mol.nao) if occ[i] > 1e-8), key=lambda i: -e[i])
    val_occ = []
    ne = 0.0
    for i in occ_idx:
        val_occ.append(i)
        ne += occ[i]
        if ne >= 6.0 - 1e-8:
            break

    val_s = [i for i in val_occ if W[:, i].argmax() == 0]
    val_d = [i for i in val_occ if W[:, i].argmax() == 2]
    val_f = [i for i in val_occ if W[:, i].argmax() == 3]

    # 2. Virtual orbitals sorted by energy
    virt_idx = [i for i in range(ctx.mol.nao) if occ[i] <= 1e-8]
    virt_d = sorted([i for i in virt_idx if W[:, i].argmax() == 2], key=lambda i: e[i])
    virt_f = sorted([i for i in virt_idx if W[:, i].argmax() == 3], key=lambda i: e[i])

    # Complete 6d to 5 orbitals, and 5f to 7 orbitals
    d_needed = max(0, 5 - len(val_d))
    f_needed = max(0, 7 - len(val_f))

    picked = sorted(val_s + val_d + virt_d[:d_needed] + val_f + virt_f[:f_needed])
    assert len(picked) == 13, f"Expected 13 valence orbitals, got {len(picked)}"

    print('\n--- CAS picks (1-based) ---')
    for i in picked:
        dom = W[:, i].argmax()
        print(f'  MO {i+1:3d}  occ={occ[i]:.1f}  e={e[i]:+.4f}  char={"spdfgh"[dom]}  purity={W[dom, i]:.2f}')
    print('  CAS composition: s^1 d^5 f^7 (Complete SO(3) atomic valence space)')
    return [i + 1 for i in picked]


def csf_config_histogram(ctx, mc, cutoff=CSF_CUTOFF):
    act = mc.mo_coeff[:, mc.ncore : mc.ncore + mc.ncas]
    dom = np.array(list('spdfgh'))[l_weights(ctx, act).argmax(0)]
    hist, betas = defaultdict(float), set()
    for c, sa, sb in large_ci_cut(mc.ci, mc.ncas, mc.nelecas, cutoff):
        a = int(str(sa), 2)
        cnt = {l: 0 for l in 'spdfgh'}
        for j in range(mc.ncas):
            if (a >> j) & 1:
                cnt[dom[j]] += 1
        key = ' '.join(f'{l}^{cnt[l]}' for l in 'spdf' if cnt[l])
        hist[key] += c * c
        betas.add(str(sb))
    return dict(sorted(hist.items(), key=lambda kv: -kv[1])), betas


def stage2_cas(ctx):
    ref_row = next((r for r in ctx.rows if r['name'] == 'ROHF'), None)
    if ref_row is None or not ref_row['conv']:
        raise RuntimeError("ROHF seed missing or unconverged for Stage 2!")

    mf_ref = ref_row['mf']
    ctx.mf_ref = mf_ref
    cas_idx = pick_cas(ctx, mf_ref)
    print('\nCAS candidate (1-based):', cas_idx)

    # --------------------------------------------------------------------------
    # 1. Single-Root CASCI Pre-Flight Registration (Frozen ROHF MOs)
    # --------------------------------------------------------------------------
    mci_pre = mcscf.CASCI(mf_ref, len(cas_idx), NELECAS)
    mci_pre.verbose = 0
    sorted_mo_pre = mci_pre.sort_mo(cas_idx)
    mci_pre.kernel(sorted_mo_pre)
    dm_ao = mci_pre.make_rdm1(ci=mci_pre.ci)
    noon_ci, natorb_ci = _sc_eigh(ctx.S @ dm_ao @ ctx.S, ctx.S)
    cfg_casci = valence_config(ctx, noon_ci[::-1], natorb_ci[:, ::-1])
    add_row(ctx, 'CASCI', mci_pre, 'frozen seed-row MOs', s2=6.0, cfg=cfg_casci)

    # --------------------------------------------------------------------------
    # 2. State-Specific CASSCF Ground State Optimization
    # --------------------------------------------------------------------------
    print("\nRunning State-Specific CASSCF Ground State Optimization...")
    mc = mcscf.CASSCF(mf_ref, len(cas_idx), NELECAS)
    mc.chkfile = 'casscf.chk'
    mc.chk_ci = True
    mc.conv_tol = CONV_TOL
    mc.verbose = VERBOSE

    mo0, ci0, e_prev = mc.sort_mo(cas_idx), None, None
    warm = WARM and os.path.exists('casscf.chk')
    if warm:
        try:
            rec = lib_chk.load('casscf.chk', 'mcscf')
            if rec.get('mo_coeff') is not None:
                mo0, ci0 = rec['mo_coeff'], rec.get('ci_vector')
                e_prev = rec.get('e_tot')
                print(f'  [casscf] warm seed (E_prev={e_prev})')
            else:
                warm = False
        except Exception as ex:
            print('  [casscf] chk seed failed:', ex)
            warm = False

    mc.max_cycle_macro = WARM_MAX_MACRO if warm else MAX_MACRO
    cc = CycleCounter()
    mc.callback = cc
    t0 = time.perf_counter()
    mc.kernel(mo0) if ci0 is None else mc.kernel(mo0, ci0)
    t_cas = time.perf_counter() - t0

    noon, natorb = addons.make_natural_orbitals(mc)
    ss, _ = addons.spin_square(mc)
    cfg = valence_config(ctx, noon, natorb)

    # Calculate L^2 on relaxed orbitals
    mo_relaxed_cas = mc.mo_coeff[:, mc.ncore : mc.ncore + mc.ncas]
    L_relaxed = get_orbital_angular_momentum(ctx.mol, mo_relaxed_cas)
    casdm1, casdm2 = mc.fcisolver.make_rdm12(mc.ci, mc.ncas, mc.nelecas)
    l2_casscf, l_eff_casscf = calc_L_square_from_rdm(L_relaxed, casdm1, casdm2)
    term_casscf = format_term_symbol(np.sqrt(ss + 0.25) * 2, l_eff_casscf)

    print(f'\nE(CASSCF) = {mc.e_tot:.8f}   <S^2> = {ss:.4f}   <L^2> = {l2_casscf:.2f}  Term = {term_casscf}')
    print('CASSCF NOONs:', np.round(noon[::-1], 3))

    hist, betas = csf_config_histogram(ctx, mc)
    print('Configuration histogram (alpha classes, |c| > cutoff):')
    for k, v in hist.items():
        print(f'   {k:16s}  sum_w = {v:.3f}')

    note = f"CAS({sum(NELECAS)},{len(cas_idx)}); Term: {term_casscf}"
    if warm and e_prev is not None:
        note += f"; dE_vs_chk {abs(mc.e_tot - e_prev):.1e}"
    mc._meta = dict(cycles=_stage('casscf', cc), t=t_cas, prec=cc.prec)
    add_row(ctx, 'CASSCF', mc, note, s2=ss, l2=l2_casscf, cfg=cfg)

    ctx.mc = mc
    ctx.noon = noon
    ctx.natorb = natorb

    # --------------------------------------------------------------------------
    # 3. Multi-root Spectroscopic Scan on RELAXED CASSCF Orbitals
    # --------------------------------------------------------------------------
    print("\n" + "="*75)
    print("  SPECTROSCOPIC SCAN ON OPTIMIZED CASSCF ORBITALS")
    print("  QUINTETS (5f^3 6d^1 7s^2) & SEPTETS (5f^3 6d^2 7s^1)")
    print("="*75)

    # (A) Relaxed Quintets (S=2, nelecas=(5,1))
    mci_q = mcscf.CASCI(mf_ref, len(cas_idx), NELECAS)
    mci_q.fcisolver.nroots = 20
    mci_q.verbose = 0
    mci_q.kernel(mc.mo_coeff)

    e0 = mci_q.e_tot[0]
    print(f"\n--- RELAXED QUINTETS (S = 2, nelecas = (5, 1)) ---")
    print(f"{'Root':<5} {'E (Eh)':<16} {'dE (eV)':<9} {'dE (cm^-1)':<12} {'<S^2>':<7} {'<L^2>':<7} {'Term'}")
    print("-" * 75)
    for k in range(mci_q.fcisolver.nroots):
        dm1, dm2 = mci_q.fcisolver.make_rdm12(mci_q.ci[k], len(cas_idx), NELECAS)
        l2, l_eff = calc_L_square_from_rdm(L_relaxed, dm1, dm2)
        de_ev = (mci_q.e_tot[k] - e0) * HARTREE2EV
        de_cm = (mci_q.e_tot[k] - e0) * HARTREE2CM
        term = format_term_symbol(5.0, l_eff)
        print(f"{k:<5} {mci_q.e_tot[k]:16.6f} {de_ev:+8.3f}  {de_cm:+10.1f}   6.00    {l2:6.1f}   {term}")

    # (B) Relaxed Septets (S=3, nelecas=(6,0))
    mci_s = mcscf.CASCI(mf_ref, len(cas_idx), (6, 0))
    mci_s.fcisolver.nroots = 6
    mci_s.verbose = 0
    mci_s.kernel(mc.mo_coeff)

    print(f"\n--- RELAXED SEPTETS (S = 3, nelecas = (6, 0)) ---")
    print(f"{'Root':<5} {'E (Eh)':<16} {'dE (eV)':<9} {'dE (cm^-1)':<12} {'<S^2>':<7} {'<L^2>':<7} {'Term'}")
    print("-" * 75)
    for k in range(mci_s.fcisolver.nroots):
        dm1, dm2 = mci_s.fcisolver.make_rdm12(mci_s.ci[k], len(cas_idx), (6, 0))
        l2, l_eff = calc_L_square_from_rdm(L_relaxed, dm1, dm2)
        de_ev = (mci_s.e_tot[k] - e0) * HARTREE2EV
        de_cm = (mci_s.e_tot[k] - e0) * HARTREE2CM
        term = format_term_symbol(7.0, l_eff)
        print(f"{k:<5} {mci_s.e_tot[k]:16.6f} {de_ev:+8.3f}  {de_cm:+10.1f}   12.00   {l2:6.1f}   {term}")
    print("="*75)


# ==============================================================================
# STAGE 3: SEEDED SCF EXPERIMENTS
# ==============================================================================
STAGE3_SPEC = [
    ('UHF<-CAS',                'UHF', 'casscf',  ('DIIS', 'SOSCF')),
    ('UKS-PBE<-CAS',            'UKS', 'casscf',  ('DIIS', 'SOSCF')),
    ('UKS-PBE<-CAS-SOSCF',      'UKS', 'casscf',  ('SOSCF',)),
    ('UKS-PBE<-UHF<-CAS',       'UKS', 'uhf_cas', ('DIIS', 'SOSCF')),
    ('UKS-PBE<-UHF<-CAS-SOSCF', 'UKS', 'uhf_cas', ('SOSCF',)),
]

def spin_occs_from_noons(noon, na, nb):
    idx = np.argsort(-noon)
    oa = np.zeros(len(noon))
    ob = np.zeros(len(noon))
    oa[idx[:na]] = 1.0
    ob[idx[:nb]] = 1.0
    return oa, ob


def stage3_scf(ctx):
    mo2 = np.asarray((ctx.natorb, ctx.natorb))
    occ2 = np.asarray(spin_occs_from_noons(ctx.noon, ctx.na, ctx.nb))
    for name, kind, seed, strategy in STAGE3_SPEC:
        xc = XC if kind == 'UKS' else None
        if seed == 'casscf':
            dm0 = make_scf(ctx, kind, xc).make_rdm1(mo2, occ2)
        else:
            row = next((r for r in ctx.rows if slug(r['name']) == seed), None)
            if row is None:
                raise KeyError(f"Seed row {seed!r} not found for {name!r}")
            dm0 = row['mf'].make_rdm1()

        mf, note = run_scf(ctx, name, kind, strategy, xc=xc, dm0=dm0)
        add_row(ctx, name, mf, note)


# ==============================================================================
# REPORT GENERATION
# ==============================================================================
def report(ctx):
    mc = ctx.mc
    hdr = (f"{'method':26} {'conv':>5} {'iterations':>26} {'tolerance':>24} "
           f"{'E, Eh':>16} {'dE,eV':>8} {'<S^2>':>7} {'<L^2>':>7} "
           f"{'match':>6}  {'configuration':30} note")
    md = ['| Method | Conv | Iterations | Tolerance | E, Eh | ΔE, eV | ⟨S²⟩ | ⟨L²⟩ | '
          'Configuration | Match | Note |',
          '|---|---|---|---|---|---|---|---|---|---|---|']

    print('\n' + '=' * 25 + ' FINAL COMPARISON ' + '=' * 25)
    print(hdr)
    for r in ctx.rows:
        conv = '✔' if r['conv'] else '✘'
        hit = '✔' if config_matches(r['cfg']) else '✘'
        dE_e = f"{(r['E'] - mc.e_tot)*HARTREE2EV:+.3f}" if (r['conv'] and mc is not None and getattr(mc, 'e_tot', None) is not None) else 'n/a'
        s2s = 'n/a' if r['S2'] is None or np.isnan(r['S2']) else f"{r['S2']:.3f}"
        l2s = 'n/a' if r.get('L2') is None or np.isnan(r['L2']) else f"{r['L2']:.1f}"

        print(f"{r['name']:26} {conv:>5} {r['cycles']:>26} {r['prec']:>24} "
              f"{r['E']:16.8f} {dE_e:>8} {s2s:>7} {l2s:>7} "
              f"{hit:>6}  {fmt_cfg(r['cfg']):30} {r['note']}")

        md.append(f"| {r['name']} | {conv} | {r['cycles']} | {r['prec']} | "
                  f"{r['E']:.8f} | {dE_e} | {s2s} | {l2s} | "
                  f"{fmt_cfg(r['cfg'])} | {hit} | {r['note']} |")

    with open('results.md', 'w') as f:
        f.write('\n'.join(md) + '\n')
    print('\nMarkdown table written to results.md')


# ==============================================================================
# MAIN ENTRY POINT
# ==============================================================================
def main():
    ctx = build_system()
    stage1_scf(ctx)
    stage2_cas(ctx)
    stage3_scf(ctx)
    report(ctx)


if __name__ == '__main__':
    main()#INFO: ******************** input file end ********************


