NELECAS    = (5, 1)               # active electrons (na, nb)
NCAS       = 13
CAS_MANUAL = None                 # 1-based MO list to override pick_cas
TARGET_CFG = {'s': 2.0, 'd': 1.0, 'f': 3.0}
CFG_TOL, CFG_PRINT_TOL = 0.3, 0.05
XC, SMEAR_SIGMA = 'pbe', 0.02
CORE_MAP   = {0: 4, 1: 12, 2: 10} # closed shells subtracted: 5s6s / 5p6p / 5d
WARM, WARM_MAX_SCF, WARM_MAX_MACRO = True, 3, 6
MAX_DIIS, MAX_SOSCF, MAX_MACRO = 100, 50, 50
DIIS_START, CONV_TOL = 1, 1e-9
VERBOSE, SCF_VERBOSE = 4, 3
CSF_CUTOFF, PRINT_CSF = 0.05, True
HARTREE2EV = 27.211386245988

STAGE1 = [
    # (name, kind, strategy)   kind in {ROHF, UHF, UKS}
    ('ROHF',           'ROHF', ('DIIS', 'SOSCF')),
    ('ROHF-smear*',    'ROHF', ('SMEAR', 'CLEAN')),
    ('UHF',            'UHF',  ('DIIS', 'SOSCF')),
    ('UHF-smear*',     'UHF',  ('SMEAR', 'CLEAN')),
    ('UKS-PBE',        'UKS',  ('DIIS', 'SOSCF')),
    ('UKS-PBE-smear*', 'UKS',  ('SMEAR', 'CLEAN')),
    ('UKS-PBE-smear-fs*', 'UKS', ('SMEARFS', 'CLEAN')),
]
STAGE2 = [
    # (name, kind, seed, preflight)   kind: 'CASCI'|'CASSCF'; seed: slug of
    # the STAGE1 row providing MOs (fail-fast if missing/unconverged);
    # preflight: print NOONs and keep E as the relaxation metric
    ('CASCI',  'CASCI',  'rohf', True),
    ('CASSCF', 'CASSCF', 'rohf', False),
]
STAGE3 = [
    # (name, kind, seed, strategy)   seed: None = cold start; 'casscf' =
    # natural orbitals + NOON-ranked occ; or a slug of an earlier row
    # (the seeded row must run EARLIER in this list)
    ('UHF<-CAS',                'UHF', 'casscf',  ('DIIS', 'SOSCF')),
    ('UKS-PBE<-CAS',            'UKS', 'casscf',  ('DIIS', 'SOSCF')),
    ('UKS-PBE<-CAS-SOSCF',      'UKS', 'casscf',  ('SOSCF',)),   # Newton from iter 1
    ('UKS-PBE<-UHF<-CAS',       'UKS', 'uhf_cas', ('DIIS', 'SOSCF')),
    ('UKS-PBE<-UHF<-CAS-SOSCF', 'UKS', 'uhf_cas', ('SOSCF',)),   # Newton from iter 1
]
# =======================================================================


# ---------------- convergence bookkeeping -------------------------------
class CycleCounter:
    """Per-iteration bookkeeping via mf.callback(envs): cycles spent, last
    |dE|, last |grad| — the achieved precision behind the table's 'conv'
    claim (loop exit alone hides stalls and oscillation). envs key names
    differ across kernels (plain SCF: norm_g; mcscf fires the callback
    twice per macro) -> known keys are tried, missing ones degrade to '—'.
    mcscf envs carry 'imacro': the distinct-imacro count is the true macro
    total ('N macro'); SCF kernels have no imacro -> plain cycle count."""
    KEYS_E = ('e_tot', 'etot')
    KEYS_G = ('norm_g', 'norm_gorb', 'grad_norm', 'gnorm')
    def __init__(self):
        self.n = 0; self.e_last = self.e_prev = None; self.g_last = None
        self.macros = set()
    def __call__(self, envs):
        self.n += 1
        im = envs.get('imacro')
        if im is not None:
            self.macros.add(int(im))
        e = next((envs[k] for k in self.KEYS_E if k in envs), None)
        if e is not None:
            self.e_prev, self.e_last = self.e_last, float(e)
        g = next((envs[k] for k in self.KEYS_G if k in envs), None)
        if g is not None:
            self.g_last = float(g)
    @property
    def prec(self):
        # no '|' inside cells: pipes break markdown table columns
        parts = []
        if None not in (self.e_last, self.e_prev):
            parts.append(f'dE {abs(self.e_last - self.e_prev):.1e}')
        if self.g_last is not None:
            parts.append(f'g {self.g_last:.1e}')
        return ', '.join(parts) if parts else '—'
    def summary(self):
        if self.macros:
            return f'{len(self.macros)} macro'
        return f'{self.n} cyc' if self.n else None


def _counted_kernel(mf, dm0=None):
    """kernel() + callback counter + wall time -> (counter, seconds)."""
    cc = CycleCounter(); mf.callback = cc
    t0 = time.perf_counter()
    mf.kernel(dm0)
    return cc, time.perf_counter() - t0


def _stage(label, cc):
    s = cc.summary()
    return f'{label} {s}' if s else label


def smear_scf(mf, sigma):
    """Gaussian fractional occupations, width sigma: smooths the SCF map and
    regularizes the frontier flip-flopping that defeats integer DIIS."""
    return _smear_fn(mf, sigma=sigma)


def large_ci_cut(ci, ncas, nelecas, cut=CSF_CUTOFF):
    """fci.addons.large_ci with the cutoff keyword located by signature."""
    params = inspect.signature(fci.addons.large_ci).parameters
    for kw in ('tol', 'lim', 'cutoff'):
        if kw in params:
            return fci.addons.large_ci(ci, ncas, nelecas, **{kw: cut})
    return fci.addons.large_ci(ci, ncas, nelecas, cut)


# ---------------- wavefunction / orbital diagnostics --------------------
def frontier_gap(mf, occ_tol=0.9):
    """HOMO->LUMO gap, eps_{N+1} - eps_N (N = #occ > occ_tol; per-spin list
    for UHF/UKS). A tiny gap means an expanding SCF fixed-point map (DIIS
    stalls) AND static correlation (the CAS is needed); printed per row in
    the run log."""
    try:
        e, o = np.asarray(mf.mo_energy), np.asarray(mf.mo_occ)
        if e.ndim == 2:
            return [float(e[s][np.where(o[s] > occ_tol)[0].max() + 1]
                          - e[s][np.where(o[s] > occ_tol)[0].max()])
                    for s in range(e.shape[0])]
        i = np.where(o > occ_tol)[0].max()
        return float(e[i + 1] - e[i])
    except Exception:
        return None


def fmt_gap(g):
    if g is None:           return '-'
    if isinstance(g, list): return '/'.join(f'{x:.1e}' for x in g)
    return f'{g:.1e}'


def fmt_cfg(cfg):
    """{'s':2.0,'d':1.0,'f':3.0} -> 's^2.00 d^1.00 f^3.00'."""
    return ' '.join(f'{l}^{n:.2f}' for l, n in cfg.items()) if cfg else '(none)'


def config_matches(cfg):
    """All TARGET_CFG components present and within CFG_TOL electrons."""
    if not cfg:
        return False
    return all(l in cfg and abs(cfg[l] - n) <= CFG_TOL
               for l, n in TARGET_CFG.items())


def slug(name):
    """Row name -> chkfile/seed tag: 'UKS-PBE<-CAS' -> 'uks_pbe_cas'.
    '<' and '-' each map to '_', so duplicates are collapsed ('<-'' would
    otherwise yield two); STAGE3 seed literals are these collapsed slugs."""
    s = (name.lower().replace('<', '_').replace('-', '_')
         .replace('*', '').replace(' ', '_'))
    while '__' in s:
        s = s.replace('__', '_')
    return s


# ---------------- system construction & population analysis --------------
def ao_l_list(mol):
    """Angular momentum l of every AO column (len = mol.nao).
    Shell b = bas_nctr(b) contracted functions of momentum bas_angular(b),
    each contributing 2l+1 (m = -l..l) columns; [l] is a one-element list,
    list * int repeats it -> one l label per column. Example: 2 s-shells +
    1 p-shell -> [0,0,1,1,1]."""
    out = []
    for b in range(mol.nbas):
        l = mol.bas_angular(b)
        out += [l] * (2*l + 1) * mol.bas_nctr(b)
    return np.array(out)


def l_weights(ctx, mo):
    """Lowdin l-composition: w[l,i] = fraction of MO i's norm carried by AOs
    of momentum l. Squared coefficients are taken in the symmetrically
    orthogonalized AO frame (C' = S^(1/2) C, C'^T C' = I), so the partition
    is exact as bookkeeping: w >= 0, sum_l w[l,i] = 1, and the electron
    count sum_l n_l = N_elec holds by construction. For a single atom S is
    block-diagonal in l, so the orthogonalization keeps l-blocks separate
    and the l-attribution of each MO is unambiguous; the split among
    functions of one l remains a statement about this basis (populations
    are not observables). UHF spin blocks are handled in valence_config,
    not here ((C_a + C_b)/2 is not S-orthonormal)."""
    if mo is None:
        raise RuntimeError('mo_coeff is None — SCF object was never run!')
    mo = np.asarray(mo, dtype=float)
    assert mo.ndim == 2, f'expect one (nao,nmo) matrix, got {mo.shape}'
    assert mo.shape[0] == ctx.l_ao.size == ctx.S.shape[0]  # labeling == rows
    s2, U = np.linalg.eigh(ctx.S)
    Co = (U * np.sqrt(s2)) @ U.T @ mo
    W = np.stack([(Co[ctx.l_ao == l]**2).sum(0)
                  for l in range(int(ctx.l_ao.max()) + 1)])
    assert np.allclose(W.sum(0), 1.0, atol=1e-8)   # partition of unity
    return W


def valence_config(ctx, occ, mo, etol=CFG_PRINT_TOL):
    """Open-valence electrons per angular momentum,
        n_l = sum_i n_i * w[l,i]  -  CORE_MAP[l]        (Lowdin populations)
    with sum_l n_l = sum_i n_i = N_elec exactly (assert). n_i = occupations:
    RHF/ROHF 2/1/0; UHF/UKS (2,nmo) with per-spin Lowdin weights then summed;
    CASSCF: NOONs (only in the natural-orbital frame do occupations exist —
    see stage2). The CASSCF result is the DENSITY's shell population, i.e.
    an ensemble average over the CI determinants (hence soft values)."""
    occ, mo = np.asarray(occ, dtype=float), np.asarray(mo, dtype=float)
    if occ.ndim == 2:
        assert mo.ndim == 3 and mo.shape[0] == occ.shape[0]
        nel = sum(o @ l_weights(ctx, c).T for o, c in zip(occ, mo))
    else:
        assert mo.ndim == 2
        nel = occ @ l_weights(ctx, mo).T
    assert abs(nel.sum() - ctx.mol.nelectron) < 1e-6, \
        f'{nel.sum()} != {ctx.mol.nelectron}'
    tags = 'spdfgh'
    raw = {tags[l]: round(float(n), 2) for l, n in enumerate(nel) if n > etol}
    val = {tags[l]: round(float(n - CORE_MAP.get(l, 0)), 2)
           for l, n in enumerate(nel) if n - CORE_MAP.get(l, 0) > etol}
    print('  per-l raw:', raw, '\n  valence  :', val)
    return val


def build_system():
    """Molecule + GRPP integrals + fixed analysis context (SimpleNamespace):
    overlap S, per-column l labels, electron counts, table rows."""
    mol = libgrpp4pyscf.GRPPMole()
    mol.build(atom=ATOM, basis=BASIS, ecp=ECP, spin=SPIN, charge=CHARGE,
              unit=UNIT, verbose=VERBOSE)
    libgrpp4pyscf.compare_integrals_with_pyscf(mol, verbose=True, gradients=False)
    l_ao = ao_l_list(mol)
    assert not mol.cart and (l_ao == 3).sum() >= 7, 'need spherical f functions'
    return SimpleNamespace(
        mol=mol, S=mol.intor('int1e_ovlp'), l_ao=l_ao,
        na=(mol.nelectron + SPIN)//2, nb=(mol.nelectron - SPIN)//2,
        rows=[], mf_ref=None, mc=None, noon=None, natorb=None)


# ---------------- SCF engine ---------------------------------------------
def make_scf(ctx, kind, xc=None):
    """Fresh mol-bound SCF object; kind in {ROHF, UHF, UKS}; quiet verbosity
    (the final table carries the analysis, not the cycle log)."""
    mf = {'ROHF': ctx.mol.ROHF, 'UHF': ctx.mol.UHF, 'UKS': ctx.mol.UKS}[kind]()
    if xc:
        mf.xc = xc
    mf.verbose = SCF_VERBOSE
    return mf


def seed_from_chk(mf, tag):
    """WARM: previous run's converged orbitals as the starting guess — a
    guess, never truth; the short re-run certifies the stored solution
    (a converged state re-converges in 1-2 cycles to the same E)."""
    path = f'{tag}.chk'
    if not (WARM and os.path.exists(path)):
        return False, None
    try:
        mol_chk, rec = scf.chkfile.load_scf(path)
        if (mol_chk.nao_nr() != mf.mol.nao_nr()
                or mol_chk.nelectron != mf.mol.nelectron):
            print(f'  [{tag}] chk belongs to a different system -> cold start')
            return False, None
        mf.mo_coeff, mf.mo_occ = rec['mo_coeff'], rec['mo_occ']
        if rec.get('mo_energy') is not None:
            mf.mo_energy = rec['mo_energy']
        print(f'  [{tag}] warm seed (E_prev={rec["e_tot"]:.8f})')
        return True, rec.get('e_tot')
    except Exception as ex:
        print(f'  [{tag}] chk seed failed ({ex}) -> cold start')
        return False, None


def run_scf(ctx, name, kind, strategy=('DIIS', 'SOSCF'), xc=None, dm0=None):
    """One SCF variant via the strategy mini-language (see module docstring).
    Warm seeding overrides the initial dm and shortens all budgets, and the
    re-run doubles as a stationarity check (dE_vs_chk in the note) — except
    SMEAR/SMEARFS/CLEAN strategies, which always run cold (module docstring
    explains why)."""
    if isinstance(strategy, str):   # missing comma: ('SOSCF') == 'SOSCF'
        raise TypeError(f"strategy for '{name}' is a string, not a tuple of "
                        f"stages — add the trailing comma: ({strategy!r},)")
    tag = slug(name)
    mf = make_scf(ctx, kind, xc)
    # warm-verify does not suit smeared rows: the frontier holds near-
    # degenerate fractional occupation pairs and the re-optimized chemical
    # potential transiently breaks the electron count, so the tiny verify
    # budget stalls instead of re-certifying; these rows are cheap -> cold
    if any(st in ('SMEAR', 'SMEARFS', 'CLEAN') for st in strategy):
        seeded, e_prev = False, None
    else:
        seeded, e_prev = seed_from_chk(mf, tag)
    if seeded:
        dm0 = mf.make_rdm1(mf.mo_coeff, mf.mo_occ)
        notes = ['warm verify']
    else:
        notes = []
    mf.chkfile, mf.conv_tol = f'{tag}.chk', CONV_TOL
    stages, wall, cc_last = [], 0.0, None
    for st in strategy:
        if st == 'DIIS':
            mf.diis_start_cycle = DIIS_START
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('DIIS', cc))
        elif st == 'SOSCF':
            mf = mf.newton()
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_SOSCF
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SOSCF', cc))
        elif st == 'SMEAR':
            mf = smear_scf(mf, SMEAR_SIGMA)
            # smearing recasts ROHF as an RHF-class object: its kernel wants
            # the spin-summed total dm, not the spin-resolved (2,nao,nao)
            # a native ROHF kernel takes; rebuild it straight from the seeded
            # (possibly fractional) occ — ROHF.make_rdm1 would binarize them
            # (occ>0 / occ==2) and break the electron count (smeared UKS
            # stays UHF-like: its 3D dm needs no change)
            if (dm0 is not None and np.ndim(dm0) == 3
                    and not mf.istype('UHF')):
                dm0 = np.dot(mf.mo_coeff * mf.mo_occ, mf.mo_coeff.T)
            mf.max_cycle = WARM_MAX_SCF if seeded else MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SMEAR', cc))
            notes.append(f'gaussian smear sigma={SMEAR_SIGMA}')
        elif st == 'SMEARFS':
            mf = _smear_fn(mf, sigma=SMEAR_SIGMA, fix_spin=True)
            mf.max_cycle = MAX_DIIS
            cc, t = _counted_kernel(mf, dm0)
            stages.append(_stage('SMEARFS', cc))
            notes.append(f'gaussian smear sigma={SMEAR_SIGMA}, fix_spin')
        elif st == 'CLEAN':
            dm = mf.make_rdm1()                  # possibly fractional dm
            mf = make_scf(ctx, kind, xc)         # fresh integer object
            mf.chkfile, mf.conv_tol = f'{tag}.chk', CONV_TOL
            mf.max_cycle = MAX_DIIS              # explicit: no pyscf default
            cc, t = _counted_kernel(mf, dm)
            stages.append(_stage('CLEAN', cc))
            notes.append('integer restart from smeared dm')
        else:
            raise ValueError(f'unknown strategy stage: {st}')
        wall += t; cc_last = cc
        if mf.converged:
            break
    if seeded and e_prev is not None and mf.converged:
        d = abs(mf.e_tot - e_prev)
        notes.append(f'stationary: dE_vs_chk {d:.1e}')
        if d > 1e-7:
            notes.append('CHECK: differs from chk!')
    mf._meta = dict(cycles=' + '.join(stages), t=wall,
                    gap=frontier_gap(mf), prec=cc_last.prec)
    return mf, '; '.join(notes) or '->'.join(strategy)


# ---------------- final-table machinery ----------------------------------
def add_row(ctx, name, mf, note, s2=None, cfg=None):
    """Register one variant; convergence metadata comes from mf._meta.
    mf is kept in the row: later stages seed from it (mf_ref, stage-3 dms).
    <Sz> from occupations: per-spin occ (UHF/UKS class, incl. fix_spin
    smearing) give the exact value; ROHF and CAS(n) have (na-nb)/2; the
    spin-summed smeared ensembles have none ('n/a')."""
    conv = bool(getattr(mf, 'converged', False))
    if conv and s2 is None:
        try:    s2 = mf.spin_square()[0]
        except Exception: s2 = np.nan       # undefined for smeared objects
    if conv and cfg is None:
        cfg = valence_config(ctx, mf.mo_occ, mf.mo_coeff)
    occ = np.asarray(mf.mo_occ, dtype=float)
    if occ.ndim == 2:                       # per-spin occ (UHF/UKS class)
        szv = float(occ[0].sum() - occ[1].sum()) / 2
    elif hasattr(mf, 'ncas'):
        szv = (ctx.na - ctx.nb) / 2         # CAS(n): active (na,nb) fixed
    elif hasattr(mf, 'istype') and mf.istype('ROHF'):
        szv = (ctx.na - ctx.nb) / 2         # ROHF: fixed (na,nb)
    else:                                   # spin-summed smeared ensemble
        szv = None
    meta = getattr(mf, '_meta', {})
    if meta.get('gap') is not None:
        print(f'  frontier gap: {fmt_gap(meta["gap"])}')
    ctx.rows.append(dict(name=name, mf=mf, conv=conv, E=mf.e_tot, S2=s2,
                         Sz=szv, cfg=cfg, note=note,
                         cycles=meta.get('cycles', '—'),
                         t=meta.get('t', 0.0), gap=meta.get('gap'),
                         prec=meta.get('prec', '—')))


# ---------------- stage 1 -------------------------------------------------
def stage1_scf(ctx):
    """All single-reference variants (declarative STAGE1)."""
    for name, kind, strategy in STAGE1:
        mf, note = run_scf(ctx, name, kind, strategy,
                           xc=XC if kind == 'UKS' else None)
        add_row(ctx, name, mf, note)


# ---------------- stage 2 -------------------------------------------------
def pick_cas(ctx, mf, nelec_val=6, ncas=NCAS):
    """Frontier rule: walk occupied MOs from the TOP of the energy scale,
    accumulating occupations until nelec_val electrons are gathered (this
    captures all partially occupied frontier orbitals plus the doubly
    occupied one that completes the count); remaining CAS slots are filled
    with the LOWEST virtuals (correlating partners). Designed for the
    atom's open-valence frontier; heuristic in general."""
    e, occ = mf.mo_energy, mf.mo_occ
    occ_idx = sorted((i for i in range(ctx.mol.nao) if occ[i] > 1e-8),
                     key=lambda i: -e[i])
    val, ne = [], 0.0
    for i in occ_idx:                    # occupied, highest energy first
        val.append(i)
        ne += occ[i]                     # gather electrons shell by shell
        if ne >= nelec_val - 1e-8:       # 6 valence electrons collected
            break
    virt = sorted((i for i in range(ctx.mol.nao) if occ[i] <= 1e-8),
                  key=lambda i: e[i])
    picked = val + virt[:ncas - len(val)]
    W = l_weights(ctx, mf.mo_coeff)
    dom, pur = W.argmax(0), W.max(0)
    print('\n--- CAS picks (1-based) ---')
    for part, lst in (('occ', val), ('virt', virt[:ncas - len(val)])):
        for i in lst:
            print(f'  MO {i+1:3d} {part}  occ={occ[i]:.1f}  e={e[i]:+.4f}'
                  f'  char={"spdfgh"[dom[i]]}  purity={pur[i]:.2f}')
    comp = {}
    for i in picked:
        comp[dom[i]] = comp.get(dom[i], 0) + 1
    print('  CAS composition: '
          + ' '.join(f'{"spdfgh"[l]}^{comp[l]}' for l in sorted(comp)))
    return sorted(i + 1 for i in picked)


def csf_config_histogram(ctx, mc, cutoff=CSF_CUTOFF):
    """Aggregate determinant weights c_I^2 over configuration classes,
    labeled by the dominant Lowdin character of each active MO (bit j of
    the string integer = active orbital j in the sort_mo feed order; bin()
    is MSB-first, so int(str(sa), 2) puts orbital 0 in bit 0). The bit -> l
    map is derived at runtime from the active orbitals. Determinant-level:
    Hund-coupled atomic terms bundle several determinants, so class weights
    are lower bounds of term weights."""
    act = mc.mo_coeff[:, mc.ncore:mc.ncore + mc.ncas]
    dom = np.array(list('spdfgh'))[l_weights(ctx, act).argmax(0)]
    print('  active-orbital l-map:', ' '.join(dom))
    hist, betas = defaultdict(float), set()
    for c, sa, sb in large_ci_cut(mc.ci, mc.ncas, mc.nelecas, cutoff):
        a = int(str(sa), 2)
        cnt = {l: 0 for l in 'spdfgh'}
        for j in range(mc.ncas):
            if (a >> j) & 1:
                cnt[dom[j]] += 1
        key = ' '.join(f'{l}^{cnt[l]}' for l in 'spdf' if cnt[l])
        hist[key] += c * c
        betas.add(str(sb))
    return dict(sorted(hist.items(), key=lambda kv: -kv[1])), betas


def run_casscf(ctx, mf_ref, cas_idx, e_casci):
    """CASSCF solve + diagnostics. Warm start: mo0 (orbitals) and ci0 (CI
    vector) from casscf.chk; the short re-run's stationarity certifies the
    stored solution. Natural orbitals: per-orbital occupations exist only
    in the frame that diagonalizes the 1-RDM, so NOs/NOONs are computed
    for valence_config and the stage-3 guess — a representation change,
    no new information; the equivalent raw spin-dm seeding (make_rdm1s)
    is noted in stage3_scf."""
    mc = mcscf.CASSCF(mf_ref, len(cas_idx), NELECAS)
    mc.chkfile = 'casscf.chk'
    mc.chk_ci = True                # store 'ci_vector' for later warm starts
    mc.conv_tol = CONV_TOL
    mc.verbose = VERBOSE
    mo0, ci0, e_prev = mc.sort_mo(cas_idx), None, None
    warm = WARM and os.path.exists('casscf.chk')
    if warm:
        try:
            rec = lib_chk.load('casscf.chk', 'mcscf')   # dump key, PySCF 2.13
            if rec.get('mo_coeff') is not None:
                mo0 = rec['mo_coeff']; ci0 = rec.get('ci_vector')
                e_prev = rec.get('e_tot')
                print(f'  [casscf] warm seed (E_prev={e_prev})')
            else:
                print('  [casscf] chk has no orbitals -> cold start')
                warm = False
        except Exception as ex:
            print('  [casscf] chk seed failed:', ex); warm = False
    mc.max_cycle_macro = WARM_MAX_MACRO if warm else MAX_MACRO
    cc = CycleCounter(); mc.callback = cc
    t0 = time.perf_counter()
    mc.kernel(mo0) if ci0 is None else mc.kernel(mo0, ci0)
    t_cas = time.perf_counter() - t0
    if e_prev is not None:
        d = mc.e_tot - e_prev
        print(f'  [casscf] stationarity: E - E_chk = {d:.2e}'
              + ('' if abs(d) < 1e-7 else '  <- raise WARM_MAX_MACRO'))

    # Natural orbitals: a representation change only (see docstring)
    noon, natorb = addons.make_natural_orbitals(mc)
    ss, _ = addons.spin_square(mc)
    cfg = valence_config(ctx, noon, natorb)
    print(f'\nE(CASSCF) = {mc.e_tot:.8f}   <S^2> = {ss:.4f}   (want ~6)')
    print('dE(CASSCF-ROHF) =', mc.e_tot - mf_ref.e_tot,
          '  (must be small & negative)')
    if e_casci is not None:
        print('orbital-relaxation gain, E(CASCI)-E(CASSCF) =',
              e_casci - mc.e_tot)
    print('CASSCF NOONs:', np.round(noon[::-1], 3))

    ci_arr = np.asarray(mc.ci).ravel()
    w_max = float(np.max(np.abs(ci_arr))**2)     # determinant-dominance bound
    dom_cls = ''
    if PRINT_CSF:
        try:
            hist, betas = csf_config_histogram(ctx, mc)
            print('configuration histogram (alpha classes, |c| > cutoff):')
            for k, v in hist.items():
                print(f'   {k:16s}  sum_w = {v:.3f}')
            print('   listed total =', round(sum(hist.values()), 3),
                  ' beta strings:', betas,
                  '(bit 0 = first active MO = 7s in the standard pick)')
            if hist:
                dom_cls = f'; dom class {next(iter(hist))}'
        except Exception as ex:
            print('  (histogram unavailable:', ex, ')')
        try:
            print('leading determinants:')
            for c, sa, sb in large_ci_cut(mc.ci, mc.ncas, mc.nelecas):
                print(f'  {c:+.4f}  w={c*c:.3f}  a:{sa}  b:{sb}')
        except Exception as ex:
            print('  (large_ci listing unavailable:', ex, ')')
    note = (f'CAS({sum(NELECAS)},{len(cas_idx)}) from seed-row MOs; '
            f'w_max={w_max:.2f}' + dom_cls
            + (f'; relax gain {e_casci - mc.e_tot:+.4f}' if e_casci else ''))
    mc._meta = dict(cycles=_stage('casscf', cc), t=t_cas, gap=None, prec=cc.prec)
    add_row(ctx, 'CASSCF', mc, note, s2=ss, cfg=cfg)
    return mc, noon, natorb, ss, cfg


def run_casci(ctx, mf_ref, cas_idx, preflight):
    """CASCI on frozen seed-row MOs — seconds; adds a table row. With
    preflight, prints the NOONs. CASCI.make_rdm1 returns the density in
    the non-orthogonal AO representation, so occupations require the
    generalized problem eigh(S dm S, b=S) (bare eigenvalues of dm are
    meaningless); eigenvectors are already AO coefficients for the Lowdin
    analysis."""
    mci = mcscf.CASCI(mf_ref, len(cas_idx), NELECAS)
    mci.verbose = VERBOSE
    cc, t = _counted_kernel(mci, mci.sort_mo(cas_idx))
    dm_ao = mci.make_rdm1()
    S = mci._scf.get_ovlp()
    noon, natorb = _sc_eigh(S @ dm_ao @ S, S)
    noon, natorb = noon[::-1], natorb[:, ::-1]
    if preflight:
        print('CASCI NOONs (top 15):', np.round(noon[:15], 3),
              ' sum =', round(float(noon.sum()), 3))
    ss, _ = addons.spin_square(mci)
    cfg = valence_config(ctx, noon, natorb)
    mci._meta = dict(cycles='—' if not cc.n else _stage('casci', cc),
                     t=t, gap=None, prec=cc.prec)
    add_row(ctx, 'CASCI', mci, 'frozen seed-row MOs', s2=ss, cfg=cfg)
    return mci.e_tot


def stage2_cas(ctx):
    """Declarative STAGE2 (see the comment on the list). The seed row
    supplies MOs (fail-fast if missing or unconverged); the CAS is picked
    once per seed; CASCI rows are cheap pre-flights (frozen MOs) whose E
    doubles as the orbital-relaxation metric for CASSCF."""
    picked, e_casci = {}, None
    for name, kind, seed, preflight in STAGE2:
        ref = next((r for r in ctx.rows if slug(r['name']) == seed), None)
        if ref is None or not ref['conv']:
            raise RuntimeError(
                f'STAGE2 seed row {seed!r} missing or not converged — fix '
                f'stage 1 first. No automatic reference substitution.')
        if seed not in picked:
            if CAS_MANUAL is not None:
                assert len(set(CAS_MANUAL)) == NCAS
                picked[seed] = list(CAS_MANUAL)
            else:
                picked[seed] = pick_cas(ctx, ref['mf'])
            print('\nCAS candidate (1-based):', picked[seed])
        cas_idx = picked[seed]
        if kind == 'CASCI':
            e_casci = run_casci(ctx, ref['mf'], cas_idx, preflight)
        else:
            ctx.mf_ref = ref['mf']
            print(f"\n** CASSCF reference: {ref['name']}  "
                  f"E={ctx.mf_ref.e_tot:.8f} **")
            ctx.mc, ctx.noon, ctx.natorb, _, _ = \
                run_casscf(ctx, ref['mf'], cas_idx, e_casci)


# ---------------- stage 3 -------------------------------------------------
def spin_occs_from_noons(noon, na, nb):
    """NOON ranking -> binary (alpha, beta) occupations for the SCF guess
    (a guess convention only — the kernel re-derives occupations): beta
    fills the nb largest NOONs (core ~2), alpha the na largest -> na-nb
    unpaired alpha (Sz = 2) emerges automatically."""
    idx = np.argsort(-noon)                  # descending NOONs
    oa = np.zeros(len(noon)); oa[idx[:na]] = 1.0
    ob = np.zeros(len(noon)); ob[idx[:nb]] = 1.0
    return oa, ob


def stage3_scf(ctx):
    """SCF experiments after stage 2 (declarative STAGE3; not necessarily
    restarts). Seeds: None = cold start (default guess); 'casscf' = natural
    orbitals + NOON-ranked binary occupations (same orbital character as
    CASSCF, so dE measures correlation treatment, not a different
    solution); a slug of an earlier row = that row's converged dm. The
    NOON step is a guess convention — the kernel re-derives integer
    occupations every cycle and only dm0 matters for the trajectory; the
    equivalent raw spin-resolved density, dm0 = ctx.mc.make_rdm1s(), is
    the documented alternative."""
    mo2 = np.asarray((ctx.natorb, ctx.natorb))
    occ2 = np.asarray(spin_occs_from_noons(ctx.noon, ctx.na, ctx.nb))
    for name, kind, seed, strategy in STAGE3:
        xc = XC if kind == 'UKS' else None
        if seed is None:
            dm0 = None                        # cold start, default guess
        elif seed == 'casscf':
            dm0 = make_scf(ctx, kind, xc).make_rdm1(mo2, occ2)
        else:   # an earlier row's dm; the row may come from this same loop
            row = next((r for r in ctx.rows
                        if slug(r['name']) == seed), None)
            if row is None:
                raise KeyError(f"seed row {seed!r} not found — it must run "
                               f"EARLIER in STAGE3 than {name!r}")
            dm0 = row['mf'].make_rdm1()
        mf, note = run_scf(ctx, name, kind, strategy, xc=xc, dm0=dm0)
        if kind == 'UHF':    # judgment deferred to cfg + <S^2> columns:
            note += (f'; dE vs ROHF {mf.e_tot - ctx.mf_ref.e_tot:+.2e}'
                     ' (polarized core if cfg matches)')
        add_row(ctx, name, mf, note)


# ---------------- report --------------------------------------------------
def report(ctx):
    """Final comparison table (text + results.md), same columns in both.
    No '|' inside cells — raw pipes break markdown table columns."""
    mc = ctx.mc
    hdr = (f"{'method':26} {'conv':>5} {'iterations':>26} {'tolerance':>24} "
           f"{'E, Eh':>16} {'dE,mEh':>9} {'E,eV':>13} {'dE,eV':>8} "
           f"{'<S^2>':>7} {'<Sz>':>6} {'match':>6}  {'configuration':30} note")
    md = ['| Method | Conv | Iterations | Tolerance | E, Eh | ΔE, mEh | '
          'E, eV | ΔE, eV | ⟨S²⟩ | ⟨Sz⟩ | Configuration | Match to ground '
          '| Note |',
          '|---|---|---|---|---|---|---|---|---|---|---|---|---|']
    print('\n' + '=' * 20 + ' final comparison ' + '=' * 20)
    print(hdr)
    for r in ctx.rows:
        conv = '✔' if r['conv'] else '✘'
        hit = '✔' if config_matches(r['cfg']) else '✘'
        dE_m = f"{(r['E'] - mc.e_tot)*1e3:+.2f}" if r['conv'] else 'n/a'
        dE_e = f"{(r['E'] - mc.e_tot)*HARTREE2EV:+.3f}" if r['conv'] else 'n/a'
        e_ev = f"{r['E'] * HARTREE2EV:.4f}"
        s2s = 'n/a' if r['S2'] is None or r['S2'] != r['S2'] else f"{r['S2']:.3f}"
        szs = 'n/a' if r['Sz'] is None else f"{r['Sz']:.2f}"
        print(f"{r['name']:26} {conv:>5} {r['cycles']:>26} {r['prec']:>24} "
              f"{r['E']:16.8f} {dE_m:>9} {e_ev:>13} {dE_e:>8} {s2s:>7} "
              f"{szs:>6} {hit:>6}  {fmt_cfg(r['cfg']):30} {r['note']}")
        md.append(f"| {r['name']} | {conv} | {r['cycles']} | {r['prec']} | "
                  f"{r['E']:.8f} | {dE_m} | {e_ev} | {dE_e} | {s2s} | {szs} | "
                  f"{fmt_cfg(r['cfg'])} | {hit} | {r['note']} |")
    with open('results.md', 'w') as f:
        f.write('\n'.join(md) + '\n')
    print('\nmarkdown table written to results.md')
    print('  * = a SMEAR stage in the strategy (see note); dE vs CASSCF is')
    print('  comparable only among HF-based rows; frontier gaps are printed')
    print('  per row in the run log.')
    print('  the UHF 5f^4 6d^0 collapse: integer occupations cannot hold the')
    print('  5f/6d-degenerate frontier — the very reason the CAS is needed.')


# ---------------- main ----------------------------------------------------
def main():
    ctx = build_system()
    stage1_scf(ctx)
    stage2_cas(ctx)
    stage3_scf(ctx)
    report(ctx)


if __name__ == '__main__':
    main()#INFO: ******************** input file end ********************


